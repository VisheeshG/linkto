# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required: used server-side for tracking redirects, shared project pages,
# password checks and project deletion. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Recommended in production: ip-api.com Pro key. Enables HTTPS lookups and
# removes the free tier's 45 requests/minute limit and non-commercial terms.
IP_API_KEY=

# Recommended: random secrets (e.g. `openssl rand -hex 32`).
# Signs shared-project access tokens (defaults to the service role key).
PROJECT_ACCESS_SECRET=
# Salt for hashed visitor IDs used in unique-visitor counts.
VISITOR_HASH_SALT=

# Optional. Leave empty so analytics follow each viewer's own time zone.
# Set an IANA name (e.g. Asia/Kolkata) only to force one zone for everyone.
NEXT_PUBLIC_ANALYTICS_TIME_ZONE=

# Public site URL used for SEO metadata.
NEXT_PUBLIC_SITE_URL=https://linkto.in
